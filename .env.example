# Unconfigured checkouts use the clearly labeled sample provider.
LUNCHBOX_AI_MODE=demo
# Eligible for free AI Gateway credits at the time this demo was built.
LUNCHBOX_AI_MODEL=google/gemini-2.5-flash
# Vercel deployments authenticate with VERCEL_OIDC_TOKEN automatically.
# For local AI testing: vercel env pull .env.local (refreshes local OIDC).
# Never put credentials in NEXT_PUBLIC_* variables or commit .env.local.
# Use existing Gateway credits only; no auto recharge or direct-provider BYOK.
