# The browser-only fixture workspace runs without configuration.
# Use a separate Supabase development project or `npx supabase start` locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this key to browser code.
SUPABASE_SERVICE_ROLE_KEY=
LUNCHBOX_HOUSEHOLD_ENABLED=false

# demo = clearly labeled authored examples. ai = authenticated local worker jobs.
LUNCHBOX_AI_MODE=demo
LUNCHBOX_AI_BACKEND=local-worker
# The worker token is server/worker only; generate a long random secret.
# Each worker is authorized for exactly one household.
LUNCHBOX_WORKER_TOKEN=
LUNCHBOX_WORKER_HOUSEHOLD_ID=
# Worker only: hosted HTTPS app URL (loopback HTTP allowed for development).
LUNCHBOX_APP_URL=http://localhost:3100
LUNCHBOX_OLLAMA_URL=http://127.0.0.1:11435
LUNCHBOX_LOCAL_MODEL=qwen3.5:27b
LUNCHBOX_LOCAL_THINKING=off
# Tested configuration: docs/evaluations/local-ai-qwen35-27b-capability-off-final.md
# Worker refuses a different installed digest; evaluate before repinning.
LUNCHBOX_LOCAL_MODEL_DIGEST=2d2e4b8fc7c0479b70f8cba9fc8bdb49a3c9a43a8a6da3873b724c9fca4672ef
# Start Ollama with OLLAMA_NO_CLOUD=1, OLLAMA_HOST=127.0.0.1:11435.
# No paid provider is used automatically. The legacy Gateway adapter only runs
# if explicitly selected by LUNCHBOX_AI_BACKEND=gateway and separately configured.
