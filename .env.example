# The starter runs without environment variables.
# The AI owner should document server-only provider keys here when connecting AI.
# Never put secret keys in NEXT_PUBLIC_* variables.

# Supabase public project URL and publishable key (safe for browser use with RLS).
# Never use a service_role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
